# AnchorPoint local Docker Compose configuration

POSTGRES_USER=anchorpoint
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=anchorpoint

# Monitoring / Alertmanager notification credentials (#1008).
# Never commit real values — these are injected into the Alertmanager
# container via --config.expand-env and referenced from
# infra/monitoring/alertmanager.yml as ${VAR} placeholders.
PAGERDUTY_ROUTING_KEY=
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#alerts
